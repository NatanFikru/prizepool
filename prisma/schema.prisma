generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
  REFUNDED
}

enum PredictionOutcome {
  HOME
  DRAW
  AWAY
}

enum TransactionType {
  DEPOSIT
  ENTRY_FEE
  WINNING
  REFUND
  PRIZEPOOL_BOOST
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  displayName  String?
  status       UserStatus    @default(ACTIVE)
  wallet       Wallet?
  predictions  Prediction[]
  transactions Transaction[]
  admin        Admin?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  totalDeposits Decimal       @default(0) @db.Decimal(12, 2)
  totalWinnings Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("ETB") @db.VarChar(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([currency])
}

model League {
  id        String   @id @default(cuid())
  apiId     Int      @unique
  name      String
  country   String?
  logo      String?
  seasons   Season[]
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([country])
}

model Season {
  id        String   @id @default(cuid())
  leagueId  String
  year      Int
  isCurrent Boolean  @default(false)
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, year])
  @@index([year])
  @@index([isCurrent])
}

model Team {
  id          String   @id @default(cuid())
  apiId       Int      @unique
  name        String
  country     String?
  logo        String?
  venueName   String?
  venueCity   String?
  homeMatches Match[]  @relation("HomeTeamMatches")
  awayMatches Match[]  @relation("AwayTeamMatches")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([country])
}

model Match {
  id              String             @id @default(cuid())
  apiFixtureId    Int?               @unique
  leagueId        String
  seasonId        String
  homeTeamId      String
  awayTeamId      String
  startsAt        DateTime
  venueName       String?
  venueCity       String?
  status          MatchStatus        @default(SCHEDULED)
  apiStatusShort  String?
  apiStatusLong   String?
  homeScore       Int?
  awayScore       Int?
  lastUpdated     DateTime?
  winningOutcome  PredictionOutcome?
  entryFee        Decimal            @default(0) @db.Decimal(12, 2)
  prizePoolAmount Decimal            @default(0) @db.Decimal(12, 2)
  league          League             @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  season          Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  homeTeam        Team               @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam        Team               @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Restrict)
  predictions     Prediction[]
  transactions    Transaction[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([leagueId])
  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([startsAt])
  @@index([status])
}

model Prediction {
  id              String            @id @default(cuid())
  userId          String
  matchId         String
  outcome         PredictionOutcome
  stakeAmount     Decimal           @db.Decimal(12, 2)
  potentialPayout Decimal?          @db.Decimal(12, 2)
  status          PredictionStatus  @default(PENDING)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  match           Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  walletId     String
  predictionId String?
  matchId      String?
  type         TransactionType
  status       TransactionStatus @default(COMPLETED)
  amount       Decimal           @db.Decimal(12, 2)
  balanceAfter Decimal?          @db.Decimal(12, 2)
  reference    String?           @unique
  description  String?
  metadata     Json?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  prediction   Prediction?       @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  match        Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([predictionId])
  @@index([matchId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id        String    @id @default(cuid())
  userId    String    @unique
  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}
